---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconWhatsapp from "@/assets/icons/socials/whatsapp.svg";
import IconMail from "@/assets/icons/socials/mail.svg";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "¿Listo para llevar tu negocio al siguiente nivel?",
  description = "Cuéntame tu idea y te envío una propuesta sin compromiso. Respondo en menos de 24 horas.",
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const whatsappUrl =
  config.socials.find(({ name }) => name === "whatsapp")?.url ??
  "https://wa.me/50488935250";
const whatsappHref = `${whatsappUrl}?text=${encodeURIComponent(
  "Hola Uziel, vi tu sitio web y me interesa cotizar un proyecto."
)}`;
---

<section
  class="border-accent/40 bg-accent/5 my-10 rounded-2xl border p-6 text-center sm:p-10"
>
  <h2 class="text-2xl font-bold sm:text-3xl">{title}</h2>
  <p class="text-muted-foreground mx-auto mt-3 max-w-xl">{description}</p>
  <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
    <a
      href={getRelativeLocaleUrl(locale, "contacto")}
      class="btn-primary"
    >
      <IconMail class="size-5" />
      Solicitar cotización
    </a>
    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-secondary"
    >
      <IconWhatsapp class="size-5" />
      Escríbeme por WhatsApp
    </a>
  </div>
</section>
