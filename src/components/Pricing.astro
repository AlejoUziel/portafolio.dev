---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconCheck from "@/assets/icons/IconCheck.svg";
import { plans } from "@/data/pricing";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const contactPath = getRelativeLocaleUrl(locale, "contacto");
---

<section id="precios" class="mt-12">
  <h2 class="text-2xl font-semibold tracking-wide">Precios</h2>
  <p class="mt-3">
    Un buen sitio web no es un gasto, es una inversión: trabaja por tu negocio
    las 24 horas, los 365 días del año.
  </p>

  <ul class="mt-10 grid gap-6 md:grid-cols-3">
    {
      plans.map(plan => (
        <li
          class:list={[
            "relative flex flex-col rounded-2xl border-2 p-6",
            plan.featured
              ? "border-accent bg-accent/5 md:-translate-y-2 md:shadow-lg"
              : "border-border bg-background",
          ]}
        >
          {plan.featured && (
            <span class="bg-accent text-accent-foreground absolute -top-3 left-1/2 -translate-x-1/2 rounded-full px-3 py-0.5 text-xs font-semibold whitespace-nowrap">
              {plan.tagline}
            </span>
          )}
          <h3 class="text-xl font-bold">{plan.name}</h3>
          {!plan.featured && (
            <p class="text-muted-foreground text-sm">{plan.tagline}</p>
          )}
          <p class="mt-4 text-3xl font-bold">{plan.price}</p>
          <ul class="mt-6 flex-1 space-y-2 text-sm">
            {plan.features.map(feature => (
              <li class="flex items-start gap-2">
                <IconCheck class="text-accent mt-0.5 size-4 shrink-0" />
                {feature}
              </li>
            ))}
          </ul>
          <a
            href={`${contactPath}?plan=${plan.id}`}
            class:list={["mt-6", plan.featured ? "btn-primary" : "btn-secondary"]}
          >
            Elegir {plan.name}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="text-muted-foreground mt-6 text-center text-sm">
    Precios negociables · Acepto pagos en USD · 50% al iniciar y 50% al
    entregar
  </p>
</section>
